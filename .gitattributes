# Normalize line endings for all text files
* text=auto

# Force LF for Python and shell scripts
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary files — no line-ending conversion
*.wav   binary
*.flac  binary
*.mp3   binary
*.joblib binary
*.parquet binary
*.png   binary
*.jpg   binary
